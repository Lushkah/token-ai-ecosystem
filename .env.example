# Platform Configuration
PLATFORM_ENV=development
PLATFORM_DEBUG=true
PLATFORM_PORT=8000
PLATFORM_HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/token_ai_ecosystem
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Token System
TOKEN_TOTAL_SUPPLY=1000000000
TOKEN_DECIMALS=18
TOKEN_SYMBOL=TAI

# Agent Configuration
AGENT_ENABLED_TYPES=developer,architect,tester,optimizer
AGENT_MAX_CONCURRENT_TASKS=10
AGENT_TIMEOUT_SECONDS=3600
AGENT_RETRY_ATTEMPTS=3

# Reward System
REWARD_BASE_AMOUNT=100
REWARD_QUALITY_MULTIPLIER=1.5
REWARD_INNOVATION_BONUS=500
REWARD_EFFICIENCY_BONUS=300

# Governance
GOVERNANCE_VOTING_PERIOD_DAYS=7
GOVERNANCE_MIN_QUORUM=30
GOVERNANCE_APPROVAL_THRESHOLD=50

# API Keys (if using external services)
AI_API_KEY=
AI_MODEL=gpt-4

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
